    <!-- Cut (Angular): M3 Expressive's "Embrace Tension" principle (mixing sharp/angular forms
         with soft/rounded ones) via the CUT corner family (a stable, non-experimental
         ShapeAppearance attribute) instead of ROUNDED - a genuinely different silhouette from the
         other three styles, not just a different radius on the same rounded-rect shape. Google's
         actual M3 Expressive polygon shape library (MaterialShapes - cookie/sunny/clover/pill,
         see androidx.compose.material3.MaterialShapes) can't be adopted here: it's a Compose-only
         Canvas/RoundedPolygon renderer with no equivalent in the ShapeAppearanceModel/
         MaterialCardView system this app's (mostly XML View-based) UI uses, and it's still
         @ExperimentalMaterial3ExpressiveApi (material3 1.5.0-alpha) besides. -->
    <style name="ShapeAppearance.Cut.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.Cut.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Cut">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Cut.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Cut.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Cut.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Cut.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Cut.Corner.ExtraLarge</item>
    </style>

    <!--
        Expressive Shapes toggle (settings key "expressive_shapes"), when turned OFF: flattens
        the app back to plain Material3 (non-Expressive) corner treatment regardless of shape_style,
        since shape_style's own preference entry is disabled/irrelevant while this is off.
    -->
    <style name="ThemeOverlay.Shapes.Standard" parent="ThemeOverlay.Shape.Modern"/>

    <!--
        Sharp / Flat Edges (settings key "rounded_edges_enabled", when turned OFF): removes corner
        rounding across cards, dialogs, and containers for a clean, sharp-edged aesthetic.
    -->
    <style name="ShapeAppearance.Sharp.Corner" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>
    <style name="ThemeOverlay.Shape.Sharp">
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerLargeIncreased">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerExtraLargeIncreased">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="shapeAppearanceCornerExtraExtraLarge">@style/ShapeAppearance.Sharp.Corner</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <!--
        One UI style theme overlay (settings key "oneui_theme_enabled").
        Deliberately structure-only, not color: extra-large rounded corners, heavier typography,
        and One UI-style preference padding - the app's existing dynamic-color/custom-accent
        toggle already covers color (and on One UI 4.1+ that toggle already tracks the device's
        real Monet/wallpaper color, since Samsung's dynamic theming is built on the same
        system_accent1/2/3 tokens). A separate fixed "Galaxy Blue" override here would fight that
        instead of composing with it, so this overlay sets no color attrs at all.
    -->
    <style name="ShapeAppearance.OneUI.Corner.ExtraSmall" parent="ShapeAppearance.Material3.Corner.ExtraSmall">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>
    <style name="ShapeAppearance.OneUI.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>

    <style name="ThemeOverlay.OneUI" parent="">
        <!-- One UI signature extra-large corners -->
        <item name="shapeAppearanceCornerExtraSmall">@style/ShapeAppearance.OneUI.Corner.ExtraSmall</item>
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.OneUI.Corner.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.OneUI.Corner.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.OneUI.Corner.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.OneUI.Corner.ExtraLarge</item>
        <!-- Bolder headline typography (One UI "SamsungOne" look) -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OneUI.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OneUI.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OneUI.TitleMedium</item>
        <!-- Preference screens: bold category headers + One UI item padding. The rikka library
             already sets listPreferredItemPadding* to 24dp/16dp and category title color to
             ?colorPrimary (whatever that resolves to - dynamic/accent/default), so those are
             free; only the text style (size/weight/spacing) is set here. -->
        <item name="preferenceTheme">@style/AppTheme.PreferenceThemeOverlay.OneUI</item>
        <!-- Explicit padding assertion (rikka's ThemeOverlay.Rikka.Material3.Preference
             sets these but isn't guaranteed to be applied when we apply at overlay level) -->
        <item name="android:listPreferredItemPaddingStart">16dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
    </style>

    <!-- Samsung SESL: 34sp expanded title, 30sp when a subtitle sits under it (all our headers
         have one). 38sp pushed long titles like "Application management" off the edge. -->
    <style name="TextAppearance.OneUI.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.OneUI.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.OneUI.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Bold Typography overlay (settings key "bold_typography").
        Applies heavier font weights for headings/titles independently of the full One UI overlay,
        so users can have bold typography without the One UI shape + preferenceTheme changes.
        Applied before ThemeOverlay.OneUI so One UI's values win when both are on.
    -->
    <style name="ThemeOverlay.Typography.Bold" parent="">
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.OneUI.HeadlineLarge</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.OneUI.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.OneUI.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Bold.TitleSmall</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Bold.ListItem</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.OneUI.CategoryTitle</item>
    </style>

    <style name="TextAppearance.Bold.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Bold.ListItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        Corner Rounding overrides (settings key "corner_rounding_override").
        Each overlay only patches shapeAppearanceCornerExtraLarge — cards, bottom sheets, and
        dialogs use the chosen size while smaller corner tokens stay proportional to the active
        shape_style. "default" (32dp) = ThemeOverlay.Shape.Modern's ExtraLarge already applied,
        no extra overlay needed. "system" = no overlay, base M3/M3Expressive tokens used.
    -->
    <style name="ShapeAppearance.CornerRounding.Gentle.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Gentle" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Gentle.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Standard.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Standard" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Standard.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Large.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">36dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Large" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Large.ExtraLarge</item>
    </style>

    <style name="ShapeAppearance.CornerRounding.Maximum.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">44dp</item>
    </style>
    <style name="ThemeOverlay.CornerRounding.Maximum" parent="">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.CornerRounding.Maximum.ExtraLarge</item>
    </style>

    <!-- "Expressive animations" off: MDC components move on the Standard springs (no bounce)
         instead of the Expressive ones the base theme sets. -->
    <style name="ThemeOverlay.Motion.Standard" parent="" tools:ignore="PrivateResource">
        <item name="motionSpringFastSpatial">@style/Motion.Material3.Spring.Standard.Fast.Spatial</item>
        <item name="motionSpringFastEffects">@style/Motion.Material3.Spring.Standard.Fast.Effects</item>
        <item name="motionSpringDefaultSpatial">@style/Motion.Material3.Spring.Standard.Default.Spatial</item>
        <item name="motionSpringDefaultEffects">@style/Motion.Material3.Spring.Standard.Default.Effects</item>
        <item name="motionSpringSlowSpatial">@style/Motion.Material3.Spring.Standard.Slow.Spatial</item>
        <item name="motionSpringSlowEffects">@style/Motion.Material3.Spring.Standard.Slow.Effects</item>
    </style>

</resources>
