<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <af.shizuku.manager.settings.DiagnosticsDashboardPreference
        android:key="diagnostics_dashboard" />

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_core"
        android:title="@string/settings_plus_category_core"
        android:icon="@drawable/ic_bolt_24"
        app:collapsible="false">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="custom_api_enabled"
            android:title="@string/settings_enhanced_api"
            android:summary="@string/settings_enhanced_api_summary"
            android:icon="@drawable/ic_code_24"
            android:defaultValue="true"
            app:badgeType="plus" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_system"
        android:title="@string/settings_plus_category_system_performance"
        android:icon="@drawable/ic_settings_suggest_24"
        android:defaultValue="false">

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="activity_manager_plus_enabled"
            android:title="@string/settings_activity_manager_plus_title"
            android:summary="@string/settings_activity_manager_plus_summary"
            android:icon="@drawable/ic_bolt_24"
            android:defaultValue="true"
            app:infoTitle="@string/help_activity_manager_plus_title"
            app:infoDetail="@string/help_activity_manager_plus_detail"
            app:badgeType="plus" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="status_bar_governor_plus_enabled"
            android:title="@string/settings_status_bar_governor_plus_title"
            android:summary="@string/settings_status_bar_governor_plus_summary"
            android:icon="@drawable/ic_outline_expand_more_24"
            android:defaultValue="true"
            app:infoTitle="@string/help_status_bar_governor_plus_title"
            app:infoDetail="@string/help_status_bar_governor_plus_detail"
            app:badgeType="plus" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="shell_interceptor_enabled"
            android:title="@string/settings_shell_interceptor"
            android:summary="@string/settings_shell_interceptor_summary"
            android:icon="@drawable/ic_terminal_24"
            android:defaultValue="true"
            app:infoTitle="@string/help_shell_interceptor_title"
            app:infoDetail="@string/help_shell_interceptor_detail"
            app:badgeType="plus" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="avf_manager_enabled"
            android:title="@string/settings_avf_manager_title"
            android:summary="@string/settings_avf_manager_summary"
            android:icon="@drawable/ic_server_24"
            android:defaultValue="true"
            app:infoTitle="@string/help_avf_manager_title"
            app:infoDetail="@string/help_avf_manager_detail"
            app:badgeType="plus" />

        <af.shizuku.manager.settings.PlusFeaturePreference
            android:key="storage_proxy_enabled"
            android:title="@string/settings_storage_proxy"
            android:summary="@string/settings_storage_proxy_summary"
            android:icon="@drawable/ic_folder_24"
            android:defaultValue="true"
            app:infoTitle="@string/help_storage_proxy_title"
            app:infoDetail="@string/help_storage_proxy_detail"
            app:badgeType="plus" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_diagnostics"
        android:title="@string/settings_advanced_category_diagnostics"
        android:icon="@drawable/ic_medical_services_24"
        android:defaultValue="true">

        <Preference
            android:key="service_doctor"
            android:title="@string/home_service_doctor_title"
            android:summary="@string/home_service_doctor_summary"
            android:icon="@drawable/ic_medical_services_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="crash_reporting_enabled"
            android:title="@string/settings_crash_reporting_title"
            android:summary="@string/settings_crash_reporting_summary"
            android:icon="@drawable/ic_bug_report_24"
            android:defaultValue="false"
            android:persistent="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="diagnostics_enabled"
            android:title="@string/settings_diagnostics_enabled"
            android:summary="@string/settings_diagnostics_enabled_summary"
            android:icon="@drawable/ic_warning_24"
            android:defaultValue="true" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="enable_activity_log"
            android:title="@string/settings_enable_activity_log"
            android:summary="@string/settings_enable_activity_log_summary"
            android:icon="@drawable/ic_history_24"
            android:defaultValue="true" />

        <Preference
            android:key="activity_log"
            android:title="@string/settings_activity_log"
            android:icon="@drawable/ic_history_24"
            android:dependency="enable_activity_log" />

        <Preference
            android:key="update_app_database"
            android:title="@string/settings_update_app_database"
            android:summary="@string/settings_update_app_database_summary"
            android:icon="@drawable/ic_autorenew" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="hide_launcher_icon"
            android:title="@string/settings_hide_launcher_icon"
            android:summary="@string/settings_hide_launcher_icon_summary"
            android:icon="@drawable/ic_visibility_off_24"
            android:defaultValue="false" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="hide_backup_settings"
            android:title="@string/settings_hide_backup_settings"
            android:summary="@string/settings_hide_backup_settings_summary"
            android:icon="@drawable/ic_folder_24"
            android:defaultValue="false" />

        <Preference
            android:key="scripting"
            android:title="@string/scripting_title"
            android:summary="@string/scripting_summary"
            android:icon="@drawable/ic_code_24" />

        <Preference
            android:key="help"
            android:title="@string/settings_help"
            android:icon="@drawable/ic_help_outline_24" />

        <Preference
            android:key="report_bug"
            android:title="@string/settings_report_bug"
            android:icon="@drawable/ic_bug_report_24" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_adb_tools"
        android:title="@string/settings_advanced_category_adb_tools"
        android:icon="@drawable/ic_adb_24"
        android:defaultValue="false">

        <Preference
            android:key="package_identity_info"
            android:title="@string/settings_package_identity_category"
            android:summary="@string/settings_package_identity_roadmap"
            android:icon="@drawable/ic_shield_24" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="legacy_pairing"
            android:summary="@string/settings_legacy_pairing_summary"
            android:title="@string/settings_legacy_pairing"
            android:icon="@drawable/ic_numeric_1_circle_outline_24" />

        <Preference
            android:key="reset_adb_keys"
            android:title="@string/settings_reset_adb_keys"
            android:summary="@string/settings_reset_adb_keys_summary"
            android:icon="@drawable/ic_autorenew" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

    <!-- Backup & Restore -->
    <af.shizuku.manager.settings.CollapsiblePreferenceCategory
        android:key="category_backup"
        android:title="@string/settings_plus_category_backup_restore"
        android:icon="@drawable/ic_folder_24"
        android:defaultValue="false">

        <Preference
            android:key="backup_settings"
            android:title="@string/settings_backup_settings"
            android:summary="@string/settings_backup_settings_summary"
            android:icon="@drawable/ic_folder_24" />

        <Preference
            android:key="restore_settings"
            android:title="@string/settings_restore_settings"
            android:summary="@string/settings_restore_settings_summary"
            android:icon="@drawable/ic_install_24" />

        <Preference
            android:key="sync_peer_settings"
            android:title="@string/settings_sync_peer_title_generic"
            android:summary="@string/settings_sync_peer_summary_generic"
            android:icon="@drawable/ic_autorenew" />

        <af.shizuku.manager.settings.GrayableIconSwitchPreference
            android:key="auto_sync_peer_settings"
            android:title="@string/settings_auto_sync_peer_title_generic"
            android:summary="@string/settings_auto_sync_peer_summary"
            android:icon="@drawable/ic_autorenew"
            android:defaultValue="true" />

    </af.shizuku.manager.settings.CollapsiblePreferenceCategory>

</PreferenceScreen>
