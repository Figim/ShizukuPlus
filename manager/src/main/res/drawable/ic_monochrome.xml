<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="432"
    android:viewportHeight="432">
    <!-- Filled hexagon silhouette — the launcher/system applies a single tint color in
         themed-icon / monochrome mode, so the icon must be an opaque filled shape rather
         than a stroke outline (the previous stroke-only design rendered as a sparse ring
         that looked broken under Pixel Launcher's minimal mode, issue #530). -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 311.0,224.0 L 266.75,300.64 L 178.25,300.64 L 134.0,224.0 L 178.25,147.36 L 266.75,147.36 Z" />
    <!-- Plus badge centered exactly on the hexagon's top-right vertex (266.75, 147.36) in this
         432-unit viewport (= 66.69, 36.84 in 108-unit ic_launcher_foreground.xml space). Half
         the badge overlaps the hexagon corner; the outward arms read as a visible badge when
         both paths are filled with the same tint in themed/monochrome icon mode. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M 259.63,118.86 h 14.25 v 21.38 h 21.38 v 14.25 h -21.38 v 21.38 h -14.25 v -21.38 h -21.38 v -14.25 h 21.38 z" />
</vector>
