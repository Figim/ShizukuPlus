<?xml version="1.0" encoding="utf-8"?>
<!-- Drop-In flavor override of main/res/xml/shortcuts.xml. Static shortcuts cannot use
     ${applicationId}, and the main copy targets af.shizuku.plus.api, which is absent on a
     Drop-In-only install, so every launcher shortcut failed. Keep the two files in sync. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_wireless_adb"
        android:enabled="true"
        android:icon="@drawable/ic_wadb_24"
        android:shortcutShortLabel="@string/home_wireless_adb_title"
        android:shortcutLongLabel="@string/home_wireless_adb_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="moe.shizuku.privileged.api"
            android:targetClass="af.shizuku.manager.MainActivity">
            <extra android:name="shortcut_action" android:value="start_wireless_adb" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="manage_apps"
        android:enabled="true"
        android:icon="@drawable/ic_settings_outline_24"
        android:shortcutShortLabel="@string/home_app_management_title"
        android:shortcutLongLabel="@string/home_app_management_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="moe.shizuku.privileged.api"
            android:targetClass="af.shizuku.manager.management.ApplicationManagementActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_terminal"
        android:enabled="true"
        android:icon="@drawable/ic_terminal_24"
        android:shortcutShortLabel="@string/shortcut_open_terminal"
        android:shortcutLongLabel="@string/home_terminal_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="moe.shizuku.privileged.api"
            android:targetClass="af.shizuku.manager.MainActivity">
            <extra android:name="shortcut_action" android:value="open_terminal" />
        </intent>
    </shortcut>
</shortcuts>